{
  "expo": {
    "name": "Tempo Libero",
    "slug": "tempo_libero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tempolibero",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF8EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jachepe23.tempo_libero"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF8EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#036930"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Tempo Libero scrive i tuoi turni del circolo nel calendario del telefono."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tempo Libero usa le tue foto per locandine e scontrini.",
          "cameraPermission": "Tempo Libero usa la fotocamera per fotografare gli scontrini."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6e3faf53-aabd-486e-a924-c2ab08714e0b"
      }
    }
  }
}
